# Copy this file to .env and paste your keys. .env is never committed to git.
# Groq (free tier, no card): https://console.groq.com
GROQ_API_KEY=
# Optional: Gemini (free tier) - not used by default any more (the fact double-check runs on Groq)
GEMINI_API_KEY=
# Optional: OpenRouter
OPENROUTER_API_KEY=
